{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "shuniji",
  "version": "0.1.0",
  "identifier": "shuniji",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "shuniji",
        "width": 800,
        "height": 600,
        "minWidth": 500,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost https://asset.localhost blob: data:",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      },
      "capabilities": [
        {
          "identifier": "main-capability",
          "description": "Main app capabilities",
          "local": true,
          "windows": ["*"],
          "permissions": [
            "core:default",
            "opener:default",
            "clipboard-manager:default",
            "global-shortcut:default",
            "autostart:default",
            "dialog:default",
            "store:default"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
